<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.aiworkbench.supervisor</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/node</string>
    <string>__ROOT__/supervisor/workbench-supervisor.mjs</string>
    <string>--root</string><string>__ROOT__</string>
    <string>--port</string><string>4477</string>
    <string>--max-restarts</string><string>6</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>__ROOT__/data/supervisor/launchd.out.log</string>
  <key>StandardErrorPath</key><string>__ROOT__/data/supervisor/launchd.err.log</string>
  <key>WorkingDirectory</key><string>__ROOT__</string>
</dict>
</plist>
