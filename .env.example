# ============================================================
# AI 开发工作台 配置示例
# 复制为 .env 后填入，.env 已被 .gitignore 忽略，请勿提交。
# ============================================================

# ---------- 独立审计（GPT，首选） ----------
# 提供后审计将优先使用 OpenAI GPT，实现"独立模型审计"。
# 未提供时按配置降级到 GLM（审计报告会如实标注 provider）。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_AUDIT_MODEL=gpt-4.1

# ---------- 独立审计（GLM，当前默认降级方案） ----------
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/anthropic
GLM_AUDIT_MODEL=glm-5.3

# ---------- 规划器 / 轻量 LLM（DeepSeek OpenAI 兼容接口） ----------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
PLANNER_MODEL=deepseek-chat

# ---------- Coding Agent：DeepSeek Harness headless ----------
# 使用本机 DSH 安装的 CLI；Agent 在独立工作副本中编码。
DSH_BIN=/Applications/DeepSeek Harness.app/Contents/Resources/runtime/cli/bin/dsh
# read-only | workspace-write | danger-full-access
# 说明：workspace-write 需要宿主机 sandbox 可用；嵌套沙箱环境请用 danger-full-access
DSH_PERMISSION_MODE=workspace-write
DSH_TIMEOUT_MS=900000

# ---------- Coding Agent：Claude Code ----------
CLAUDE_BIN=claude
# 若使用第三方 Anthropic 兼容端点（如 GLM），可在此覆盖；留空则沿用 Claude Code 自身配置
CLAUDE_BASE_URL=
CLAUDE_API_KEY=
CLAUDE_MODEL=
CLAUDE_TIMEOUT_MS=600000

# ---------- GitHub（阶段三） ----------
# 需要 repo 细粒度权限：Contents / Pull requests / Actions (Read)
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO_PREFIX=ai-workbench-

# ---------- 预算与策略 ----------
MAX_TOTAL_TOKENS=3000000
MAX_COST_CNY=30
MAX_ATTEMPTS=2
MAX_AGENT_CONCURRENCY=2

# ---------- 服务 ----------
WORKBENCH_HOST=127.0.0.1
WORKBENCH_PORT=4477
