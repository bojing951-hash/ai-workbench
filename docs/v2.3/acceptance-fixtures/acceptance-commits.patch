+// 报告（report）：把归约状态（state.js 输出）汇总为统计报告，供 CLI（cli.js）展示。
+// 约定：byStatus 一律从 tasks 重新推导，不信任调用方传入的 counts，两者不一致时以 tasks 为准；
+// completionRate 为完成百分比（0-100 的整数，四舍五入）；空状态（无任务）安全返回全 0。
+
+function countByStatus(tasks) {
+  const byStatus = { pending: 0, running: 0, done: 0, blocked: 0 };
+  for (const taskId of Object.keys(tasks)) {
+    const { status } = tasks[taskId];
+    if (Object.prototype.hasOwnProperty.call(byStatus, status)) {
+      byStatus[status] += 1;
+    }
+  }
+  return byStatus;
+}
+
+export function buildReport(state) {
+  const tasks = state.tasks || {};
+  const byStatus = countByStatus(tasks);
+  const total = Object.keys(tasks).length;
+  const completed = byStatus.done;
+  const completionRate = total === 0 ? 0 : Math.round((completed / total) * 100);
+  return {
+    total,
+    completed,
+    blocked: byStatus.blocked,
+    running: byStatus.running,
+    pending: byStatus.pending,
+    completionRate,
+    byStatus,
+  };
+}
