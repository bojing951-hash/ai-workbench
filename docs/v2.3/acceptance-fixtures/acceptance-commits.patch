+// 账本（ledger）：在事件存储之上封装任务命令（create/start/complete/block）。
+// 约定：先按当前归约状态校验流转合法性，非法流转抛错且不写入任何事件；
+// done 为终态；start 仅允许 pending/blocked；complete 仅允许 running；
+// block 需给出 reason，pending/running/blocked 均可 block，done 不可。
+
+import { appendEvent, readEvents } from './events.js';
+import { reduceState } from './state.js';
+
+function requireTask(state, taskId, action) {
+  const task = state.tasks[taskId];
+  if (!task) {
+    throw new Error(`cannot ${action} unknown task: ${taskId}`);
+  }
+  return task;
+}
+
+function requireStatus(task, allowed, taskId, action) {
+  if (!allowed.includes(task.status)) {
+    throw new Error(`cannot ${action} task ${taskId} in status ${task.status}`);
+  }
+}
+
+export function createLedger(store) {
+  return {
+    createTask(taskId, title) {
+      const state = reduceState(readEvents(store));
+      if (state.tasks[taskId]) {
+        throw new Error(`task already exists: ${taskId}`);
+      }
+      return appendEvent(store, { type: 'task.created', taskId, payload: { title } });
+    },
+
+    startTask(taskId) {
+      const task = requireTask(reduceState(readEvents(store)), taskId, 'start');
+      requireStatus(task, ['pending', 'blocked'], taskId, 'start');
+      return appendEvent(store, { type: 'task.started', taskId });
+    },
+
+    completeTask(taskId) {
+      const task = requireTask(reduceState(readEvents(store)), taskId, 'complete');
+      requireStatus(task, ['running'], taskId, 'complete');
+      return appendEvent(store, { type: 'task.completed', taskId });
+    },
+
+    blockTask(taskId, reason) {
+      const task = requireTask(reduceState(readEvents(store)), taskId, 'block');
+      requireStatus(task, ['pending', 'running', 'blocked'], taskId, 'block');
+      return appendEvent(store, { type: 'task.blocked', taskId, payload: { reason } });
+    },
+
+    getState() {
+      return reduceState(readEvents(store));
+    },
+
+    getEvents(query = {}) {
+      return readEvents(store, query);
+    },
+  };
+}
