+// 状态归约（state reduction）：把事件流（由 events.js 产生）折叠为当前任务状态与统计计数。
+// 约定：任务初始为 pending；done 为终态，迟到/乱序的 started、blocked 或重复事件都不会把 done 降级；
+// 归约前先按 seq 稳定排序，保证乱序输入也能得到确定结果。
+
+function ensureTask(tasks, taskId) {
+  if (!tasks[taskId]) {
+    tasks[taskId] = { title: undefined, status: 'pending' };
+  }
+  return tasks[taskId];
+}
+
+function applyEvent(task, event) {
+  if (event.type === 'task.created') {
+    const title = event.payload && event.payload.title;
+    if (title !== undefined) {
+      task.title = title;
+    }
+  } else if (event.type === 'task.started') {
+    if (task.status !== 'done') {
+      task.status = 'running';
+    }
+  } else if (event.type === 'task.completed') {
+    task.status = 'done';
+  } else if (event.type === 'task.blocked') {
+    if (task.status !== 'done') {
+      task.status = 'blocked';
+    }
+  }
+}
+
+function countByStatus(tasks) {
+  const counts = { pending: 0, running: 0, done: 0, blocked: 0 };
+  for (const taskId of Object.keys(tasks)) {
+    const { status } = tasks[taskId];
+    if (Object.prototype.hasOwnProperty.call(counts, status)) {
+      counts[status] += 1;
+    }
+  }
+  return counts;
+}
+
+export function reduceState(events) {
+  const tasks = {};
+  const ordered = [...events].sort((a, b) => (a.seq || 0) - (b.seq || 0));
+  for (const event of ordered) {
+    applyEvent(ensureTask(tasks, event.taskId), event);
+  }
+  return { tasks, counts: countByStatus(tasks) };
+}
