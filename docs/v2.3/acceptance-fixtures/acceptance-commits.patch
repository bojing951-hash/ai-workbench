+#!/usr/bin/env node
+// 命令行入口（CLI）：把 ledger.js 的任务命令接到文件持久化的事件存储上。
+// 约定：--file <path> 指定事件文件（JSON 数组）；每次启动加载全部事件重建 store
+// （逐条走 appendEvent 重新校验并重排 seq），变更命令成功后才整体写回文件，失败不写回；
+// create/start/complete 成功时打印追加的事件，list 打印 report.js 汇总加 tasks 明细；
+// 任何错误统一输出到 stderr 并以退出码 1 结束。
+
+import fs from 'node:fs';
+import path from 'node:path';
+import { parseArgs } from 'node:util';
+
+import { appendEvent, createStore } from './events.js';
+import { createLedger } from './ledger.js';
+import { buildReport } from './report.js';
+
+const USAGE = `usage: cli.js --file <events.json> <command> [options]
+commands:
+  create --id <id> --title <title>
+  start --id <id>
+  complete --id <id>
+  list`;
+
+const COMMANDS = {
+  create: { options: { id: { type: 'string' }, title: { type: 'string' } }, mutates: true },
+  start: { options: { id: { type: 'string' } }, mutates: true },
+  complete: { options: { id: { type: 'string' } }, mutates: true },
+  list: { options: {}, mutates: false },
+};
+
+// 从 argv 中摘出全局选项 --file（支持 --file <path> 与 --file=<path>），其余留给子命令。
+function extractFileArg(argv) {
+  const rest = [];
+  let file;
+  for (let i = 0; i < argv.length; i += 1) {
+    const arg = argv[i];
+    if (arg === '--file') {
+      if (i + 1 >= argv.length) {
+        throw new Error('--file requires a path');
+      }
+      file = argv[i + 1];
+      i += 1;
+    } else if (arg.startsWith('--file=')) {
+      file = arg.slice('--file='.length);
+    } else {
+      rest.push(arg);
+    }
+  }
+  return { file, rest };
+}
+
+function loadStore(file) {
+  const store = createStore();
+  if (!fs.existsSync(file)) {
+    return store;
+  }
+  const records = JSON.parse(fs.readFileSync(file, 'utf8'));
+  if (!Array.isArray(records)) {
+    throw new Error(`event file must contain a JSON array: ${file}`);
+  }
+  for (const record of records) {
+    appendEvent(store, record);
+  }
+  return store;
+}
+
+function saveStore(file, store) {
+  fs.mkdirSync(path.dirname(file), { recursive: true });
+  fs.writeFileSync(file, `${JSON.stringify(store.events, null, 2)}\n`);
+}
+
+function requireOption(values, name) {
+  if (values[name] === undefined) {
+    throw new Error(`missing required option --${name}`);
+  }
+  return values[name];
+}
+
+function execute(ledger, command, argv) {
+  const { options } = COMMANDS[command];
+  const { values } = parseArgs({ args: argv, options });
+  switch (command) {
+    case 'create': {
+      const event = ledger.createTask(requireOption(values, 'id'), requireOption(values, 'title'));
+      console.log(JSON.stringify(event));
+      break;
+    }
+    case 'start': {
+      const event = ledger.startTask(requireOption(values, 'id'));
+      console.log(JSON.stringify(event));
+      break;
+    }
+    case 'complete': {
+      const event = ledger.completeTask(requireOption(values, 'id'));
+      console.log(JSON.stringify(event));
+      break;
+    }
+    case 'list': {
+      const state = ledger.getState();
+      console.log(JSON.stringify({ ...buildReport(state), tasks: state.tasks }, null, 2));
+      break;
+    }
+  }
+}
+
+function main() {
+  const { file, rest } = extractFileArg(process.argv.slice(2));
+  if (!file) {
+    throw new Error(`--file <path> is required\n${USAGE}`);
+  }
+  const [command, ...commandArgs] = rest;
+  if (!command || !Object.hasOwn(COMMANDS, command)) {
+    throw new Error(`unknown or missing command\n${USAGE}`);
+  }
+  const store = loadStore(file);
+  const ledger = createLedger(store);
+  execute(ledger, command, commandArgs);
+  if (COMMANDS[command].mutates) {
+    saveStore(file, store);
+  }
+}
+
+try {
+  main();
+} catch (err) {
+  console.error(`error: ${err.message}`);
+  process.exitCode = 1;
+}
