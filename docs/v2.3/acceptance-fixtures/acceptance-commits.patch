+// 追加式事件存储（append-only event store）。
+// 约定：事件类型固定为 task.created / task.started / task.completed / task.blocked；
+// appendEvent 负责分配递增 seq；对外返回浅拷贝，内部保存冻结副本。
+
+const EVENT_TYPES = ['task.created', 'task.started', 'task.completed', 'task.blocked'];
+
+function validateEvent(event) {
+  if (event === null || typeof event !== 'object' || Array.isArray(event)) {
+    throw new TypeError('event must be a non-null object');
+  }
+  if (typeof event.type !== 'string' || event.type.length === 0) {
+    throw new TypeError('event.type must be a non-empty string');
+  }
+  if (!EVENT_TYPES.includes(event.type)) {
+    throw new TypeError(`unknown event type: ${event.type}`);
+  }
+  if (typeof event.taskId !== 'string' || event.taskId.length === 0) {
+    throw new TypeError('event.taskId must be a non-empty string');
+  }
+  if (event.type === 'task.created') {
+    const title = event.payload && event.payload.title;
+    if (typeof title !== 'string' || title.length === 0) {
+      throw new TypeError('task.created requires a non-empty payload.title');
+    }
+  }
+  if (event.type === 'task.blocked') {
+    const reason = event.payload && event.payload.reason;
+    if (typeof reason !== 'string' || reason.length === 0) {
+      throw new TypeError('task.blocked requires a non-empty payload.reason');
+    }
+  }
+}
+
+export function createStore() {
+  return { events: [] };
+}
+
+export function appendEvent(store, event) {
+  validateEvent(event);
+  const stored = Object.freeze({ ...event, seq: store.events.length + 1 });
+  store.events.push(stored);
+  return { ...stored };
+}
+
+export function readEvents(store, { taskId } = {}) {
+  return store.events
+    .filter((e) => taskId === undefined || e.taskId === taskId)
+    .map((e) => ({ ...e }));
+}
