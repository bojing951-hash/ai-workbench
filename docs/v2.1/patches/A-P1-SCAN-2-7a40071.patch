+
+    # as_of after the reference date is a future claim.
+    store.conn.execute(
+        "UPDATE scan_runs SET as_of='2026-01-04' WHERE scan_id=?", (SCAN_ID,)
+    )
+    store.conn.commit()
+    message = _expect_rejection(store, "is in the future relative to")
