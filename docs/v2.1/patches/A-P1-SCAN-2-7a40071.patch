+# --------------------------------------------- mismatched reports / provenance
+def test_mismatched_artifacts_are_rejected(tmp_path, monkeypatch):
+    store, config_hash, data_hash, _, output_fingerprint = _make_scan(tmp_path)
+    _patch_readiness(monkeypatch)
+
+    # 1) scan JSON carries a different config hash than the recomputed one.
+    reports, exports, _, scan_json, _ = _write_artifacts(
+        tmp_path, config_hash, data_hash, output_fingerprint
+    )
+    doc = json.loads(scan_json.read_text(encoding="utf-8"))
+    doc["meta"]["config_hash"] = "not-the-config"
+    _rewrite_json(scan_json, doc)
+    message = _expect_rejection(
+        store, "scan json meta.config_hash disagrees with DB",
+        reports=reports, exports=exports, require_reports=True,
